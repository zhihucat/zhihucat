[Unit]
Description=ARGUS+ TypeScript API (compiled Node.js service)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/argus
EnvironmentFile=/opt/argus/backend/.env
Environment=HOST=127.0.0.1
Environment=PORT=4100
ExecStart=/usr/bin/node /opt/argus/backend/dist/server.js
Restart=always
RestartSec=5
User=argus
Group=argus
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
