{
  "name": "argus-platform",
  "version": "0.1.0",
  "private": true,
  "description": "ARGUS+ legal training platform: Next.js frontend and standalone Node.js backend",
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm --workspace backend run build",
    "build:frontend": "npm --workspace frontend run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:database": "node --test supabase/schema.test.mjs",
    "start:frontend": "npm --workspace frontend run start",
    "start:backend": "npm --workspace backend run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
